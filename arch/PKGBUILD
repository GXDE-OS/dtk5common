# Maintainer: justforlxz <justforlxz@gmail.com>
pkgname=dtkcommon-git
pkgver=6.7.43
pkgrel=3
pkgdesc='DTK common modules'
arch=('any')
url="https://github.com/linuxdeepin/dtkcommon"
license=('BSD-3-Clause' 'CC0-1.0')
depends=('dconf')
makedepends=('git' 'cmake' 'ninja')
provides=('dtkcommon')
conflicts=('dtkcommon')
groups=('deepin-git')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  # CMake project() only accepts numeric versions, drop suffixes like .r8.gabc123
  version=$(echo "$pkgver" | grep -oE '^[0-9]+(\.[0-9]+){0,3}')
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DDTK_VERSION="$version" \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_PREFIX=/usr
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 "$(_srcroot)/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
